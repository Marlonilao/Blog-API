# Copy this file to .env (for development) and to .env.test (for tests),
# then fill in your own values. Use a different database in each file.

# Local PostgreSQL connection string.
# With a password: postgresql://USER:PASSWORD@localhost:5432/blog_api
# Without one (Linux, logged in as the same user as Postgres):
#   postgresql://USER@localhost/blog_api?host=/var/run/postgresql
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/blog_api"

# Port the API listens on.
PORT=3000

# Addresses of the two sites that may call the API, separated by commas.
CORS_ORIGINS="http://localhost:5173,http://localhost:5174"

# The blog's single author, created by `npm run seed`.
AUTHOR_USERNAME="author"
AUTHOR_PASSWORD="change-me-please"

# Secret used to sign login tokens. Use a long random string, e.g. the
# output of: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="replace-with-a-long-random-string"
